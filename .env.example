# ============================================================================
# SokoviaPlay — Plantilla de variables de entorno
# ----------------------------------------------------------------------------
# Copiar a `.env.local` y completar con valores reales.
# `.env.local` NUNCA debe commitearse (está en .gitignore).
# ============================================================================

# --- Supabase --------------------------------------------------------------
# Clave pública (segura en el cliente: RLS protege los datos)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave privada: SOLO uso servidor (Server Actions / route handlers).
# ⚠️ Nunca debe exponerse en el cliente ni llevar el prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- TMDB (The Movie Database) --------------------------------------------
# Clave privada: se consume únicamente desde el servidor.
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3

# --- Reproductor híbrido ---------------------------------------------------
# Servidor principal de embed para película completa
NEXT_PUBLIC_VIDSRC_BASE_URL=https://vidsrc.to/embed/movie
